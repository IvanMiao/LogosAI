{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logosai-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "vars": {
    "FASTAPI_ORIGIN": "https://logosai.fly.dev",
    "BETTER_AUTH_URL": "https://logosai.ymiao.dev",
    "TRUSTED_ORIGINS": "https://logosai.ymiao.dev"
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "LOGOSAI_DB",
      "database_name": "logosai-users",
      "database_id": "b5d33fc3-5c6c-4646-a27f-5fe826eab5fd",
      "migrations_dir": "migrations"
    }
  ]
}
